Meta.DisplayName=The Riftbreaker
Meta.Description=The Riftbreaker Dedicated Server - A base-building survival game with up to 4 player co-op
Meta.OS=3
Meta.Author=Community Contributed
Meta.URL=https://riftbreaker.com
Meta.DisplayImageSource=steam:780310
Meta.ConfigManifest=riftbreakerconfig.json
Meta.MetaConfigManifest=riftbreakermetaconfig.json
Meta.ConfigRoot=riftbreaker.kvp
Meta.ConfigVersion=3
Meta.AppConfigId=a7b8c9d0-e1f2-3456-7890-abcdef123456
# NOTE: Dropped Docker/SpecificDockerImage requirement - on a plain LXC
# (no nested Docker configured) this alone can block instance startup.
# The Proton pattern below runs directly on the host via SteamCMD.
Meta.ContainerPolicy=NoPreference
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False

App.DisplayName=The Riftbreaker
App.RootDir=./riftbreaker/

# SteamCMD downloads land in <RootDir>/<appid>/ automatically.
App.WorkingDir=4114030/bin
App.ExecutableWin=4114030/bin/DedicatedServer.exe

# TODO: UNVERIFIED FILENAME. All research points to "DedicatedServer.exe"
# in a bin/ subfolder, but your original file assumed the same name too -
# after the first SteamCMD download completes, check the actual filename
# in the downloaded 4114030/ folder and correct App.ExecutableWin if needed.

# Proton (App ID 1580130 = Proton 6.3) is downloaded via SteamCMD below
# and used to run the Windows exe on Linux - this is CubeCoders' own
# documented pattern, not a custom Wine/Xvfb wrapper.
App.ExecutableLinux=1580130/proton
App.LinuxCommandLineArgs=run {{$ExecutableWin}}
App.CommandLineArgs={{$PlatformArgs}}

App.EnvironmentVariables={"LD_LIBRARY_PATH": "./linux64:%LD_LIBRARY_PATH%", "SteamAppId": "{{$SteamAppID}}", "STEAM_COMPAT_DATA_PATH": "{{$FullRootDir}}1580130", "STEAM_COMPAT_CLIENT_INSTALL_PATH": "{{$FullRootDir}}1580130"}

App.Compatibility=0

# TODO: UNVERIFIED. SIGTERM should propagate through Proton to the
# wrapped .exe - your original used ExitMethod=String/ExitString=quit,
# but there's no documented evidence "quit" is a recognized console
# command for this server. Test SIGTERM first; fall back to Kill if
# the instance hangs on stop.
App.ExitMethod=SIGTERM

App.HasWriteableConsole=True
App.HasReadableConsole=True
App.AdminMethod=STDIO

App.ApplicationIPBinding=0.0.0.0
# TODO: UNVERIFIED PORTS. 27015/27016 UDP matches one third-party Docker
# project's defaults, kept from your original file, but no official
# EXOR documentation confirms these. Watch console/netstat after first
# start and correct if wrong.
App.ApplicationPort1=27015
App.ApplicationPort2=27016
App.MaxUsers=4

App.SteamUpdateAnonymousLogin=True
App.SteamForceWindowsVersion=True
App.RapidStartup=False

# Two real update stages: 1) force-download the Windows dedicated
# server build, 2) download Proton to run it. No fabricated
# "CreateFile" stage - that isn't a valid AMP UpdateSource type, which
# is why your Linux launcher.sh was never actually being created.
App.UpdateSources=[{"UpdateStageName": "SteamCMD Download - Riftbreaker Dedicated Server", "UpdateSourcePlatform": "All", "UpdateSource": "SteamCMD", "UpdateSourceData": "4114030", "ForceDownloadPlatform": "Windows"}, {"UpdateStageName": "Proton Compatibility Layer", "UpdateSourcePlatform": "Linux", "UpdateSource": "SteamCMD", "UpdateSourceData": "1580130"}]

Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
# TODO: UNVERIFIED. Placeholder inherited from your original file -
# watch the raw console after first start for the real "ready" line
# and tighten this regex to match it specifically.
Console.AppReadyRegex=^.*[Ss]erver (started|ready|listening|running).*$
Console.UserJoinRegex=^.*[Pp]layer (?<username>.+?) (joined|connected).*$
Console.UserLeaveRegex=^.*[Pp]layer (?<username>.+?) (left|disconnected).*$
Console.UserChatRegex=
Console.MetricsRegex=
