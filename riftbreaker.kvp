Meta.DisplayName=The Riftbreaker
Meta.Description=The Riftbreaker Dedicated Server - A base-building survival game with up to 4 player co-op
Meta.OS=3
Meta.Author=Community Contributed
Meta.URL=https://riftbreaker.com
Meta.DisplayImageSource=steam:780310
Meta.EndpointURIFormat=
Meta.ConfigManifest=riftbreakerconfig.json
Meta.ConfigRoot=riftbreaker.kvp
Meta.MinAMPVersion=2.4.5.0
Meta.ConfigVersion=1
Meta.AppConfigId=a7b8c9d0-e1f2-3456-7890-abcdef123456
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=True
Meta.ContainerPolicy=RequiredOnLinux
Meta.ContainerPolicyReason=The server requires Wine and an isolated virtual frame-buffer display to run properly.
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
App.DisplayName=The Riftbreaker
App.RootDir=./riftbreaker/
App.BaseDirectory=./riftbreaker/
App.ExecutableWin=4114030\bin\DedicatedServer.exe
App.ExecutableLinux=/usr/bin/wine
App.WorkingDir=4114030/bin
App.WindowsCommandLineArgs=disable_steam=1
App.LinuxCommandLineArgs=explorer /desktop=Riftbreaker,1024x768 ./DedicatedServer.exe disable_steam=1
App.CommandLineArgs={{$PlatformArgs}} {{$FormattedArgs}}
App.CommandLineParameterFormat=-{0} "{1}"
App.UseLinuxIOREDIR=False
App.EnvironmentVariables={"SteamAppId": "780310", "WINEDEBUG": "-all"}
App.ExitMethod=String
App.ExitString=quit
App.ExitTimeout=30
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.AdminMethod=STDIO
App.ApplicationIPBinding=0.0.0.0
App.ApplicationPort1=27015
App.ApplicationPort2=27016
App.MaxUsers=4
App.UseRandomAdminPassword=False
App.PrimaryApplicationPortRef=ApplicationPort1
App.UniversalSleepApplicationUse498=False
App.SteamUpdateAnonymousLogin=True
App.RapidStartup=False
App.Compatibility=0
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.SmartExcludePaths=[]
App.UpdateSources=[{"UpdateStageName":"SteamCMD Download","UpdateSource":"SteamCMD","UpdateSourceData":"4114030","UpdateSourcePlatform":"All","ForceDownloadPlatform":"Windows"}]
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^.*[Ss]erver (started|ready|listening|running).*$
Console.UserJoinRegex=^.*[Pp]layer (?<username>.+?) (joined|connected).*$
Console.UserLeaveRegex=^.*[Pp]layer (?<username>.+?) (left|disconnected).*$
Console.UserChatRegex=
Console.MetricsRegex=
